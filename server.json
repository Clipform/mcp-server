{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.Clipform/mcp-server",
  "description": "Interactive video forms that capture authentic responses. Build engaging forms in minutes.",
  "version": "1.46.2",
  "websiteUrl": "https://www.clipform.io",
  "repository": {
    "url": "https://github.com/clipform/mcp-server",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@clipform/mcp-server",
      "version": "1.46.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLIPFORM_API_KEY",
          "description": "API key that scopes tool calls to your workspace (create one in the dashboard under Settings, API keys). Not needed to list tools, only to call them.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "API_URL",
          "description": "Clipform API base URL.",
          "isRequired": true,
          "default": "https://api.clipform.io"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.clipform.io"
    }
  ]
}
